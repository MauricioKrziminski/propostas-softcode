# Copie este arquivo para `.env.local` e preencha. O `.env.local` NÃO vai para o
# repositório (o .gitignore já cuida disso). Este aqui vai, e por isso não pode
# ganhar nenhum valor real.

# ── banco ────────────────────────────────────────────────────────────────────
# Supabase > Connect > Transaction pooler (porta 6543, não a 5432).
# O modo transação é o que funciona em serverless; a porta 5432 abre uma conexão
# por invocação e o pooler recusa depois de algumas.
# Formato:
#   postgresql://postgres.<ref>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# A senha é a do banco (Project Settings > Database). Se não souber qual é,
# gere uma nova ali mesmo: nada além deste arquivo depende dela.
DATABASE_URL=

# ── admin ────────────────────────────────────────────────────────────────────
# Hash scrypt da senha do painel. Gere com:
#   node scripts/gerar-senha.mjs "a senha que voce quiser"
# A senha em texto puro nunca é guardada, nem aqui nem no servidor.
ADMIN_SENHA_HASH=

# Segredo que assina o cookie de sessão do admin. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor derruba todas as sessões abertas, que é o jeito de expulsar
# alguém se a senha vazar.
SESSAO_SEGREDO=

# ── produção (Vercel) ────────────────────────────────────────────────────────
# Só em produção. Localmente nada disto é necessário.

# Domínio público, usado para montar o endereço absoluto das imagens de
# compartilhamento (o card do WhatsApp). Sem barra no fim.
NEXT_PUBLIC_URL_BASE=https://propostas.softcodedev.com.br

# Segredo que a Vercel manda no cabeçalho do cron diário (/api/pulso), que existe
# para o projeto Supabase gratuito não pausar por inatividade. A Vercel gera e
# injeta este valor sozinha ao criar o cron; só preencha se quiser um próprio.
CRON_SECRET=
